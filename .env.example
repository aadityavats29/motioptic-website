# Production domain defaults to content/site.json; override only for another host.
SITE_URL=https://motioptic.com
# Microsoft 365 / GoDaddy mailbox: hyder@motioptic.com.
# Configure these privately in Vercel. Requires a tenant-admin-authorized mail app.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Optional alternative receiver if Microsoft Graph authorization is unavailable.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=
# Automatically enabled for Vercel production, disabled locally and in preview.
# ANALYTICS_ENABLED=true
# Enable only when your Vercel plan supports custom events.
ANALYTICS_CUSTOM_EVENTS=false
